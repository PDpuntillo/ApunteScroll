<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: qué datos se copian a la nube de Google o a un teléfono nuevo. Por ahora nada,
    igual que allowBackup="false": todo queda en este teléfono (PLAN.md, sección 1). La copia de
    seguridad propia (exportar e importar un .zip) llega en F6; ahí se revisa esta decisión.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
