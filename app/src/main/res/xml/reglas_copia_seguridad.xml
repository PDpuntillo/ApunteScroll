<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8 a 11: misma decisión que reglas_extraccion_datos.xml (Android 12+). Por ahora no se
    copia nada fuera del teléfono; se revisa en F6.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
