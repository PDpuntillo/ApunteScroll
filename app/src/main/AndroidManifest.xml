<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        La app no pide permisos en tiempo de ejecución: los PDFs se eligen con el selector de
        archivos del sistema y se copian a la carpeta privada. Las librerías agregan permisos
        normales: INTERNET (envío de diagnósticos de ML Kit), ACCESS_NETWORK_STATE (WorkManager y
        ML Kit), y WAKE_LOCK, RECEIVE_BOOT_COMPLETED y FOREGROUND_SERVICE (WorkManager; la app no
        usa servicios en primer plano).

        La intercepción (F3) usa un servicio de accesibilidad con su aviso y consentimiento propios,
        y el permiso normal QUERY_ADVANCED_PROTECTION_MODE para explicar si la Protección avanzada
        de Android 17 lo apagó. La app no usa QUERY_ALL_PACKAGES ni SYSTEM_ALERT_WINDOW
        (PoliticaIntercepcionTest).
    -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <queries>
        <!-- Solo para mostrar en Ajustes si están instaladas. No hace falta para recibir sus
             eventos ni para volver a ellas. Sin QUERY_ALL_PACKAGES. Tiene que coincidir con
             Redes.CONOCIDAS (PoliticaIntercepcionTest). -->
        <package android:name="com.instagram.android" />
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:name=".ApunteScrollApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_extraccion_datos"
        android:fullBackupContent="@xml/reglas_copia_seguridad"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApunteScroll"
        tools:targetApi="33">

        <!-- Pide a Google Play que descargue el modelo de OCR al instalar la app. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Botón «Ajustes» de la página del servicio en Accesibilidad de Android: abre Ajustes > Redes. -->
        <activity-alias
            android:name=".ui.AbrirAjustesRedes"
            android:exported="true"
            android:targetActivity=".ui.MainActivity" />

        <!-- Feed de apuntes encima de una red. Tarea propia (si no, NEW_TASK la metería en la de la
             app y "atrás" volvería a la Biblioteca); fuera de Recientes; noHistory: se cierra apenas
             dejás de verla. Sin showWhenLocked: no aparece sobre la pantalla de bloqueo. -->
        <activity
            android:name=".intercepcion.FeedInterceptadoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.apuntescroll.interceptado" />

        <!-- Detecta qué app pasa a primer plano. El nombre de la clase NO se cambia después de
             publicar: Android guarda el servicio activado por su nombre y renombrarlo lo apagaría
             en todos los teléfonos (PoliticaIntercepcionTest). -->
        <service
            android:name=".intercepcion.ServicioIntercepcion"
            android:exported="true"
            android:label="@string/servicio_nombre"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/servicio_intercepcion" />
        </service>
    </application>
</manifest>
